<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <CheckForOverflowUnderflow>false</CheckForOverflowUnderflow>
    <!-- The translation behind a TODO stub stays unreachable until the stub is implemented (CS0162).
         Unit Finalize methods keep the Delphi section name (CS0465).
         The metaclass registry runs before static fields (CA2255). -->
    <!-- Delphi zeroes fields, including fields assigned only by pending boundary bodies (CS0649). -->
    <NoWarn>$(NoWarn);CS0162;CS0465;CS0649;CA2255</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Aow.Game" />
    <InternalsVisibleTo Include="Aow.Platform" />
    <InternalsVisibleTo Include="Aow.Units.Tests" />
    <!-- Keep unit declarations before their partial files to preserve initializer order. -->
    <Compile Include="*.cs" Exclude="*.*.cs" />
    <Compile Include="*.*.cs" />
    <ProjectReference Include="../Rtl/Aow.Rtl.csproj" />
    <ProjectReference Include="../Graphics/Aow.Graphics.csproj" />
    <!-- The own formats (own-formats.md 3.1). Formats never references Units. -->
    <ProjectReference Include="../Formats/Aow.Formats.csproj" />
    <Compile Include="../Layout/**/*.cs" Exclude="../Layout/obj/**/*.cs;../Layout/bin/**/*.cs" />
  </ItemGroup>
</Project>
