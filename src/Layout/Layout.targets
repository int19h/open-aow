<Project>
  <PropertyGroup>
    <AowLayoutGeneratedProject>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../Generated/Aow.Generated.csproj'))</AowLayoutGeneratedProject>
  </PropertyGroup>
  <ItemGroup Condition="'$(MSBuildProjectFullPath)' == '$(AowLayoutGeneratedProject)'">
    <Compile Include="$(MSBuildThisFileDirectory)**/*.cs" Exclude="$(MSBuildThisFileDirectory)obj/**/*.cs;$(MSBuildThisFileDirectory)bin/**/*.cs" />
  </ItemGroup>
</Project>
