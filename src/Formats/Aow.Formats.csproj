<Project Sdk="Microsoft.NET.Sdk">
  <!-- The port's own save and map formats and the original-format converter (own-formats.md).
       References only Aow.Rtl. Unit mappings enter with 9.7-3. -->
  <PropertyGroup>
    <RootNamespace>Aow.Formats</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="schema.json" LogicalName="Aow.Formats.schema.json" />
    <EmbeddedResource Include="versions.json" LogicalName="Aow.Formats.versions.json" />
    <EmbeddedResource Include="Migrations/schema-v1.json" LogicalName="Aow.Formats.Migrations.schema-v1.json" />
    <EmbeddedResource Include="Migrations/schema-v2.json" LogicalName="Aow.Formats.Migrations.schema-v2.json" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Aow.Formats.Tests" />
    <InternalsVisibleTo Include="Aow.Units.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Rtl\Aow.Rtl.csproj" />
  </ItemGroup>
</Project>
