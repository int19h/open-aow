<Project Sdk="Microsoft.NET.Sdk">
  <!-- The SDL host (platform.md). ppy.SDL3-CS provides the SDL3 binding and the native
       libraries for Windows and Linux; the host keeps its use behind the IRtlHost services. -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <RootNamespace>Aow.Platform</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ppy.SDL3-CS" Version="2026.1002.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Rtl\Aow.Rtl.csproj" />
    <ProjectReference Include="..\Units\Aow.Units.csproj" />
  </ItemGroup>
  <!-- Native libraries built by vcpkg from the repository's vcpkg.json (README, "Native libraries").
       They are copied next to the game when present. Without them the port runs silent. -->
  <PropertyGroup>
    <AowVcpkgTriplet Condition="'$(AowVcpkgTriplet)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">x64-windows</AowVcpkgTriplet>
    <AowVcpkgTriplet Condition="'$(AowVcpkgTriplet)' == '' and $([MSBuild]::IsOSPlatform('Linux'))">x64-linux-dynamic</AowVcpkgTriplet>
    <AowVcpkgInstalled>$(MSBuildThisFileDirectory)../../vcpkg_installed/$(AowVcpkgTriplet)/</AowVcpkgInstalled>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(AowVcpkgInstalled)bin/*.dll" Exclude="$(AowVcpkgInstalled)bin/yasm*.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" LinkBase="." />
    <None Include="$(AowVcpkgInstalled)lib/*.so*" CopyToOutputDirectory="PreserveNewest" Visible="false" LinkBase="." />
  </ItemGroup>
</Project>
