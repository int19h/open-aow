# Case opt-outs. The rule stays at its severity everywhere else.
# IDE0130. These folders are not namespace segments.
[src/Rtl/Delphi/*.cs]
dotnet_diagnostic.IDE0130.severity = none

[src/Rtl/Legacy/*.cs]
dotnet_diagnostic.IDE0130.severity = none

[src/Rtl/Host/Localize/*.cs]
dotnet_diagnostic.IDE0130.severity = none

[src/Rtl/Host/{ConsoleOutput,Installation}.cs]
dotnet_diagnostic.IDE0130.severity = none

[src/Rtl.Tests/Delphi/*.cs]
dotnet_diagnostic.IDE0130.severity = none

[src/Rtl.Tests/Host/*.cs]
dotnet_diagnostic.IDE0130.severity = none

[src/Rtl.Tests/Legacy/*.cs]
dotnet_diagnostic.IDE0130.severity = none

[src/Rtl.Tests/GeneratedStyleSample.cs]
dotnet_diagnostic.IDE0130.severity = none

[src/Formats/Tree/EnumCatalog.cs]
dotnet_diagnostic.IDE0130.severity = none

# IDE0240, IDE0241, IDE0370, IDE0080. The game library carries a file-level
# nullable disable and a null-forgiving operator records a known non-null.
[{src/Game/*.cs,src/Game/**/*.cs,src/Engine/*.cs,src/Engine/**/*.cs}]
dotnet_diagnostic.IDE0240.severity = none
dotnet_diagnostic.IDE0241.severity = none
dotnet_diagnostic.IDE0370.severity = none
dotnet_diagnostic.IDE0080.severity = none
